{
  "name": "@vrmc/desktop-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "vrmc-bridge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@vrmc/protocol": "workspace:*",
    "ws": "^8.21.3",
    "@vrmc/devices": "workspace:*"
  },
  "optionalDependencies": {
    "@julusian/midi": "^3.8.1",
    "koffi": "^3.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
