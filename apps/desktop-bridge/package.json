{
  "name": "@vrmc/desktop-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "vrmc-bridge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node native/test/run.mjs",
    "clean": "rm -rf dist .turbo",
    "bundle": "node build/bundle.mjs",
    "package": "pnpm bundle && node build/package.mjs",
    "tray": "node native/build.mjs"
  },
  "dependencies": {
    "@vrmc/devices": "workspace:*",
    "@vrmc/protocol": "workspace:*",
    "multicast-dns": "^7.2.5",
    "node-datachannel": "^0.33.2",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@julusian/midi": "^3.8.1",
    "koffi": "^3.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@vrmc/web": "workspace:*",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
