//
// Embeds the VRMC icon in the tray helper, so the executable is self-contained
// and there is no icon file beside it that packaging could lose.
//
// The path reaches the shared asset rather than a copy: one icon, generated by
// assets/icon/generate.py, used by the tray, the installer and the .app alike.

#define IDI_VRMC 101

IDI_VRMC ICON "../../../../assets/icon/vrmc.ico"
