# Port the XR client and pairing service are served on. The container publishes
# this on loopback only; point your existing reverse proxy at it.
#
# Copy to .env to change it:  cp .env.example .env
WEB_PORT=8080

# Wildcard domain whose subdomains resolve to private LAN addresses, letting a
# headset reach a bridge over a genuinely valid certificate. See
# docs/PAIRING.md for the DNS and certificate setup this needs.
LAN_DOMAIN=lan.vrmc.eionstudios.com
