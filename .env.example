# Port the XR client and pairing service are served on. The container publishes
# this on loopback only; point your existing reverse proxy at it.
#
# Copy to .env to change it:  cp .env.example .env
WEB_PORT=8080

# That is the whole file. Connecting a headset to a desktop needs no DNS
# records and no certificates: the two negotiate a direct WebRTC data channel,
# and this container only passes the handshake between them. See
# docs/PAIRING.md.
